digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.8", splines=polyline, fontname="Arial", labelloc=t, fontsize=18, label="Crownfield Eye Hospital logical ER diagram"];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, color="#3E5363", dir=both, arrowsize=0.8];
patient [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>patient</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK patient_id</TD></TR><TR><TD ALIGN="LEFT">patient_name</TD></TR><TR><TD ALIGN="LEFT">postcode</TD></TR><TR><TD ALIGN="LEFT">contact_email_cipher ?</TD></TR><TR><TD ALIGN="LEFT">contact_iv ?</TD></TR></TABLE>>];
specialty [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>specialty</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK specialty_id</TD></TR><TR><TD ALIGN="LEFT">specialty_name</TD></TR></TABLE>>];
clinician [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>clinician</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK clinician_id</TD></TR><TR><TD ALIGN="LEFT">clinician_name</TD></TR><TR><TD ALIGN="LEFT">FK specialty_id ?</TD></TR></TABLE>>];
clinic [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>clinic</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK clinic_id</TD></TR><TR><TD ALIGN="LEFT">clinic_name</TD></TR></TABLE>>];
appointment [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>appointment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK appointment_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id</TD></TR><TR><TD ALIGN="LEFT">FK clinician_id</TD></TR><TR><TD ALIGN="LEFT">FK clinic_id</TD></TR><TR><TD ALIGN="LEFT">appointment_at</TD></TR><TR><TD ALIGN="LEFT">appointment_status</TD></TR><TR><TD ALIGN="LEFT">notes ?</TD></TR></TABLE>>];
diagnosis [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>diagnosis</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK diagnosis_id</TD></TR><TR><TD ALIGN="LEFT">diagnosis_name</TD></TR></TABLE>>];
appointment_diagnosis [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>appointment_diagnosis</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK appointment_id</TD></TR><TR><TD ALIGN="LEFT">PK FK diagnosis_id</TD></TR></TABLE>>];
prescription [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>prescription</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK prescription_id</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id</TD></TR><TR><TD ALIGN="LEFT">prescription_status</TD></TR></TABLE>>];
medicine [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>medicine</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK medicine_id</TD></TR><TR><TD ALIGN="LEFT">medicine_name</TD></TR></TABLE>>];
prescription_item [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>prescription_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK prescription_id</TD></TR><TR><TD ALIGN="LEFT">PK line_no</TD></TR><TR><TD ALIGN="LEFT">FK medicine_id</TD></TR><TR><TD ALIGN="LEFT">dose ?</TD></TR><TR><TD ALIGN="LEFT">route ?</TD></TR><TR><TD ALIGN="LEFT">frequency ?</TD></TR><TR><TD ALIGN="LEFT">duration_days ?</TD></TR></TABLE>>];
follow_up_plan [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>follow_up_plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK follow_up_id</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id</TD></TR><TR><TD ALIGN="LEFT">due_date</TD></TR><TR><TD ALIGN="LEFT">priority</TD></TR><TR><TD ALIGN="LEFT">follow_up_status</TD></TR></TABLE>>];
treatment [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>treatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK treatment_id</TD></TR><TR><TD ALIGN="LEFT">treatment_name</TD></TR></TABLE>>];
appointment_treatment [label=<<TABLE BORDER="1" COLOR="#B3C0C9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#19384F"><FONT COLOR="white"><B>appointment_treatment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK appointment_treatment_id</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id</TD></TR><TR><TD ALIGN="LEFT">FK treatment_id</TD></TR><TR><TD ALIGN="LEFT">treatment_status</TD></TR><TR><TD ALIGN="LEFT">treatment_notes ?</TD></TR></TABLE>>];
patient -> appointment [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
specialty -> clinician [arrowtail=teeodot, arrowhead=crowodot, taillabel="0..1", headlabel="0..*", labeldistance=2.0];
clinician -> appointment [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
clinic -> appointment [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
appointment -> appointment_diagnosis [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
diagnosis -> appointment_diagnosis [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
appointment -> prescription [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
prescription -> prescription_item [arrowtail=teetee, arrowhead=crowtee, taillabel="1", headlabel="1..*", labeldistance=2.0];
medicine -> prescription_item [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
appointment -> follow_up_plan [arrowtail=teetee, arrowhead=teeodot, taillabel="1", headlabel="0..1", labeldistance=2.0];
appointment -> appointment_treatment [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
treatment -> appointment_treatment [arrowtail=teetee, arrowhead=crowodot, taillabel="1", headlabel="0..*", labeldistance=2.0];
}